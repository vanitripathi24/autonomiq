# Database: SQLite by default. For Supabase/Postgres use e.g.
# DATABASE_URL=postgresql+psycopg2://USER:PASS@HOST:5432/postgres
DATABASE_URL=sqlite:///./autonomiq.db

# PayPal Developer Sandbox (https://developer.paypal.com/dashboard/applications/sandbox)
# Leave blank to run in simulated-payment mode.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE=https://api-m.sandbox.paypal.com

# Optional LLM (agents fall back to a deterministic rules engine without a key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:5173
